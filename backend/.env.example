# FarmVision AI Assistant - Local Environment Configuration Example
# Copy this file to .env and configure your replacement key locally.
# Never commit your actual .env file to Git.

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
APP_ENV=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*
REQUEST_TIMEOUT_SECONDS=180.0
